<?xml version='1.0' encoding='UTF-8'?>
<beast version="2.8"
       namespace="beast.core:beast.core.util:beast.evolution.alignment:beast.evolution.nuc:beast.evolution.operators:beast.evolution.sitemodel:beast.evolution.substitutionmodel:beast.evolution.tree.coalescent:beast.base.core:beast.base.evolution.alignment:beast.base.evolution.likelihood:beast.base.evolution.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.inference:beast.base.inference.operator:beast.base.inference.util:beast.pkgmgmt:feast.simulation:coalre.network:coalre.statistics:coalre.simulator:coalre.operators:coalre.distribution">

    <run spec="MCMC" chainLength="100000000">

        <state>
            <stateNode id="network" spec="SimulatedCoalescentNetwork" nSegments="8" enableSegmentTreeUpdate="false">
                <populationModel spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                    <popSize value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
                </populationModel>

                <reassortmentRate value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>

                <traitSet spec="beast.base.evolution.tree.TraitSet" traitname="date-backward" id="traitSet">
                    <taxa spec="beast.base.evolution.alignment.TaxonSet" id="taxonSet">
                        <taxon spec="Taxon" id="t1"/>
                        <taxon spec="Taxon" id="t2"/>
                        <taxon spec="Taxon" id="t3"/>
                        <taxon spec="Taxon" id="t4"/>
                        <taxon spec="Taxon" id="t5"/>
                    </taxa>

                    t1=0, t2=0.1, t3=0.2, t4=0.3, t5=0.4
                </traitSet>
            </stateNode>
        </state>

        <distribution id="coalDensity" spec="CoalescentWithReassortment">
            <networkIntervals spec="NetworkIntervals" network="@network"/>

            <populationModel id="splinePop" spec="coalre.dynamics.NeDynamicsFromSpline">
                <spline id="spline" spec="coalre.dynamics.Spline" infectedIsNe="true" gridPoints="500">
                    <logInfected id="logInfected" value="1 1 2 1.5 1 0" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="Real"/>
                    <rateShifts id="rateShifts" value="0 1 2 3 4 5" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="Real"/>
                    <uninfectiousRate id="recoveryRate" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
                </spline>
            </populationModel>

            <reassortmentRate value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
        </distribution>

        <operator spec="AddRemoveReassortmentCoalescent" network="@network" coalescentWithReassortment="@coalDensity" weight="1.0"/>
        <!-- <operator spec="AddRemoveReassortmentCoalescent" network="@network" weight="1.0"/> -->

        <operator spec="DivertSegmentOperator" network="@network" weight="1.0" divertOneSegment="true"/>

        <logger spec="Logger" logEvery="1000" mode="tree" fileName="$(filebase).trees">
            <log idref="network"/>
        </logger>

        <logger spec="Logger" logEvery="10000" fileName="$(filebase).log">
            <log spec="NetworkStatsLogger" network="@network"/>
        </logger>

        <logger spec="Logger" logEvery="10000">
            <log spec="NetworkStatsLogger" network="@network"/>
        </logger>
    </run>

</beast>
