<?xml version='1.0' encoding='UTF-8'?>
<beast version="2.8"
       namespace="beast.core:beast.core.util:beast.evolution.alignment:beast.evolution.nuc:beast.evolution.operators:beast.evolution.sitemodel:beast.evolution.substitutionmodel:beast.evolution.tree.coalescent:beast.base.core:beast.base.evolution.alignment:beast.base.evolution.likelihood:beast.base.evolution.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.inference:beast.base.inference.operator:beast.base.inference.util:beast.pkgmgmt:feast.simulation:coalre.network:coalre.statistics:coalre.simulator">

    <network id="network" spec="SimulatedCoalescentNetwork" enableSegmentTreeUpdate="false">
        <populationModel spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
            <popSize value="0.5" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
        </populationModel>

        <reassortmentRate value="1.5" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>

        <taxonSet spec="TaxonSet" id="taxonSet">
            <taxon spec="Taxon" id="t1"/>
            <taxon spec="Taxon" id="t2"/>
            <taxon spec="Taxon" id="t3"/>
            <taxon spec="Taxon" id="t4"/>
            <taxon spec="Taxon" id="t5"/>
        </taxonSet>

        <traitSet spec="TraitSet" traitname="date-backward" id="traitSet" taxa="@taxonSet">
            t1=0, t2=0.1, t3=0.2, t4=0.3, t5=0.4
        </traitSet>

        <segmentTree id="segment1" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment2" spec="Tree" trait="@traitSet"/>
    </network>

    <run spec="GPSimulator" nSims="100000">

        <simulationObject idref="network"/>

        <logger spec="Logger" logEvery="100" mode="tree" fileName="$(filebase).trees">
            <log idref="network"/>
        </logger>

        <logger spec="Logger" logEvery="1" fileName="$(filebase).log">
            <log spec="NetworkStatsLogger" network="@network"/>
        </logger>
    </run>
</beast>
