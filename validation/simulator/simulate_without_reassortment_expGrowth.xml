<?xml version='1.0' encoding='UTF-8'?>
<beast version="2.8"
       namespace="beast.core:beast.core.util:beast.evolution.alignment:beast.evolution.nuc:beast.evolution.operators:beast.evolution.sitemodel:beast.evolution.substitutionmodel:beast.evolution.tree.coalescent:beast.base.core:beast.base.evolution.alignment:beast.base.evolution.likelihood:beast.base.evolution.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.inference:beast.base.inference.operator:beast.base.inference.util:beast.pkgmgmt:feast.simulation:coalre.network:coalre.statistics:coalre.simulator">

    <network id="simulated_network" spec="SimulatedCoalescentNetwork" enableSegmentTreeUpdate="false">
        <populationModel id="popModel" spec="beast.base.spec.evolution.tree.coalescent.ExponentialGrowth">
            <popSize value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
            <growthRate value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
        </populationModel>

        <reassortmentRate value="0.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>

        <traitSet spec="TraitSet" traitname="date-backward" id="traitSet">
            <taxa spec="TaxonSet" id="taxonSet">
                <taxon spec="Taxon" id="t1"/>
                <taxon spec="Taxon" id="t2"/>
                <taxon spec="Taxon" id="t3"/>
                <taxon spec="Taxon" id="t4"/>
                <taxon spec="Taxon" id="t5"/>
                <taxon spec="Taxon" id="t6"/>
                <taxon spec="Taxon" id="t7"/>
                <taxon spec="Taxon" id="t8"/>
                <taxon spec="Taxon" id="t9"/>
                <taxon spec="Taxon" id="t10"/>
            </taxa>

            t1=0, t2=0.1, t3=0.2, t4=0.3, t5=0.4,
            t6=0, t7=0.1, t8=0.2, t9=0.3, t10=0.4
        </traitSet>

        <segmentTree id="segment1" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment2" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment3" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment4" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment5" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment6" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment7" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment8" spec="Tree" trait="@traitSet"/>
    </network>

    <tree id="simulated_tree" spec="beast.base.spec.evolution.tree.coalescent.RandomTree">
        <taxonset idref="taxonSet"/>
        <trait idref="traitSet"/>
        <populationModel idref="popModel"/>
    </tree>

    <run spec="GPSimulator" nSims="100000">

        <simulationObject idref="simulated_network"/>

        <simulationObject idref="simulated_tree"/>

        <logger spec="Logger" fileName="$(filebase).log" logEvery="1">
            <log spec="NetworkStatsLogger" network="@simulated_network"/>
            <log spec="TreeStatLogger" tree="@simulated_tree"/>
        </logger>
    </run>
</beast>
