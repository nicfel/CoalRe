<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>beast-package</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <files>
        <file>
            <source>${project.basedir}/version.xml</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <!-- Source JAR at top level (BEAST convention: PKG_NAME.src.jar) -->
        <file>
            <source>${project.build.directory}/${project.build.finalName}-sources.jar</source>
            <destName>${beast.pkg.name}.src.jar</destName>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>

    <!-- Allow-list: bundle only CoalRe's own jar plus its non-BEAST runtime deps.
         BEAST core jars are provided by the platform — bundling them causes a
         split-package clash in the package ModuleLayer at BEAUti startup. -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>/lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <scope>runtime</scope>
            <includes>
                <include>io.github.nicfel:coalre</include>
                <include>colt:colt</include>
                <include>org.apache.commons:commons-math3</include>
            </includes>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <!-- Allow-list: ship the analyses and their input data only. A working copy
             also holds run output (.log/.trees/.state), which would otherwise be
             swept into the release archive. -->
        <fileSet>
            <directory>${project.basedir}/src/test/resources/coalre/examples</directory>
            <outputDirectory>/examples</outputDirectory>
            <includes>
                <include>*.xml</include>
                <include>*.fasta</include>
                <include>*.R</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/src/main/resources/coalre/fxtemplates</directory>
            <outputDirectory>/fxtemplates</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
